# ZNote — files that must never enter version control.
#
# Rule of thumb: anything a build step can regenerate, anything machine-specific,
# and anything holding local user data stays out. Committed source is limited to
# hand-authored code, hand-authored docs, and the byte-pinned vendored assets
# under public/vendor/.
#
# NOTE: .gitignore has no inline trailing comments. Every comment must occupy its
# own line, otherwise the comment text becomes part of the pattern and silently
# matches nothing.

# --- Dependencies -----------------------------------------------------------
node_modules/
.pnpm-store/
.venv/
.uv-cache/

# --- Build output (regenerated by the scripts in scripts/) ------------------
# vite build
dist/
# PyInstaller workpath + renderer-dist, consumed by tauri.conf.json
build/
# cargo
src-tauri/target/
# regenerated by tauri dev / tauri build
src-tauri/gen/schemas/
# legacy renderer drop location; the live one is build/renderer-dist
src-tauri/bin/
# packaged ZIPs; immutable once published, never committed
release/

# --- Local release tooling --------------------------------------------------
# Produces the distributable ZIP. It is not needed to build or test the product,
# so it is not part of the published source. Every other file in scripts/ is
# required by a build or test step and stays committed.
scripts/package-portable.py

# --- Local development archive ---------------------------------------------
# Internal roadmaps, iteration records, research material and QA screenshots.
# Deliberately kept out of the published tree. See .dev-archive/README.md.
.dev-archive/

# --- Local application data -------------------------------------------------
# WebView2 dev profile (see README)
.znote/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]

# --- Test and QA output -----------------------------------------------------
test-results/
playwright-report/
blob-report/
*.log

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example

# --- Editors and operating systems -----------------------------------------
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
