root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,js,mjs,json,css,html}]
indent_size = 2

[*.py]
indent_size = 4

[*.rs]
indent_size = 4

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[{*.ps1,*.cmd,*.bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
